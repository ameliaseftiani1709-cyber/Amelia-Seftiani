# Salin file ini menjadi ".env" lalu isi dari TiDB Cloud (tombol Connect → Connect With: General)
TIDB_HOST=isi_host_tidb
TIDB_PORT=4000
TIDB_USER=isi_username.root
TIDB_PASSWORD=isi_password
TIDB_DATABASE=lab_inventory

# Teks acak panjang untuk menandatangani token login
JWT_SECRET=ganti-dengan-teks-acak-yang-panjang
